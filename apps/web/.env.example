# Прокси Vite (vite.config.ts):
#   /v1, /auth → VITE_DEV_API_PROXY_TARGET (API, например :8001 или :8003)
#   /ai → localhost:8000 (python-ai-service в Docker) — меняйте порт в vite.config.ts при необходимости
# Пример: VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8003
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8003

# URL Python backend
VITE_API_URL=
# ID ассистента
VITE_ASSISTANT_ID=
# Опционально, LangSmith API ключ (не нужно для локальной работы)
VITE_LANGSMITH_API_KEY=

# Basic Auth credentials для API (обязательные)
VITE_API_USERNAME=
VITE_API_PASSWORD=

# Telegram-бот для бета-теста (ссылка на форме /beta-test)
VITE_TELEGRAM_BOT_USERNAME=ImpulseBetaBot
